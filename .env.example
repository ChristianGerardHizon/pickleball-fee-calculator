# Used by Wrangler / GitHub Actions. Never expose these in client code.
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=

# Cloudflare Turnstile (bot protection on login / create account)
# Client site key is public. Secret stays server-side only.
# Local dummy (invisible, always pass): site 1x00000000000000000000BB
# secret 1x0000000000000000000000000000000AA
PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
